VK_TOKEN=
VK_GROUP_ID=

# Ключ авторизации из кабинета GigaChat, без префикса Basic.
GIGACHAT_AUTH_TOKEN=
# PERS — физлицо, B2B — корпоративные пакеты, CORP — корпоративная постоплата.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: путь к PEM-файлу доверенных сертификатов для GigaChat.
# По умолчанию check_gigachat.py использует .certs/gigachat.pem, если он существует.
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_MODEL=GigaChat-2-Pro

DATABASE_PATH=data/bot.sqlite3
ADMIN_PORT=8080
# Сгенерировать значения: python -m pulkovo.cli init-config
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=
# Реальные обращения можно передавать только после определения допустимых
# условий работы с провайдером и включения текста согласия в админке (ссылка необязательна).
ALLOW_EXTERNAL_USER_DATA=false
